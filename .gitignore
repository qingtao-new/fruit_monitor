config/config.json

# ===== 数据库与数据（全为运行时产物：库、备份、ML 模型、迁移数据集）=====
data/

# ===== 日志 =====
logs/
*.log
*.err
*.out

# ===== 分析输出 / 临时结果 =====
*.json
!config/*.example.json
!package.json

# ===== IDE / 编辑器 =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

